---
import Basis from '../layouts/Basis.astro';
import Seitenkopf from '../components/Seitenkopf.astro';
import AnfrageBand from '../components/AnfrageBand.astro';
import { FRAGEN } from '../data/fragen';
import { BEGRIFFE } from '../data/begriffe';
import { fragenSchema } from '../lib/schema';
import { VDS_VERZEICHNIS } from '../lib/firma';
---
<Basis
  titel="Rechtssicherheit bei der Elektrothermografie – Fragen und Antworten"
  beschreibung="Wer darf Elektrothermografie nach VdS 2860 durchführen, welchen Bericht braucht der Versicherer, wie oft prüfen? Antworten für Betreiber und VEFK."
  brotkrumen={[]}
  jsonld={[fragenSchema(FRAGEN), {
    '@context': 'https://schema.org', '@type': 'DefinedTermSet', name: 'Fachbegriffe der Elektrothermografie',
    url: new URL('/faq/#begriffe', Astro.site).href,
    hasDefinedTerm: BEGRIFFE.map(({ b, d }) => ({ '@type': 'DefinedTerm', name: b, description: d })),
  }]}
>
  <Seitenkopf
    titel="Rechtssicherheit bei der Elektrothermografie"
    einleitung="Die Infrarot-Thermografie nach VdS 2860 und DIN 54191 ist die rechtssichere Zustandsanalyse elektrischer Anlagen im laufenden Betrieb – wenn ein paar Regeln eingehalten werden."
  />
  <section class="abschnitt">
    <div class="huelle">
      <div class="kurz">
        <h2>Das Wichtigste in drei Sätzen</h2>
        <p>
          Lassen Sie die Elektrothermografie nur von einem VdS-anerkannten Sachverständigen mit
          ET-Anerkennungsnummer durchführen. Bestehen Sie auf einem Untersuchungsbericht nach VdS 2860.
          Und planen Sie die Prüfungen nach DGUV Vorschrift 3 und Klausel SK 3602 als eigene Termine ein.
        </p>
        <p><a href={VDS_VERZEICHNIS} rel="noopener">Verzeichnis der VdS-anerkannten Sachverständigen für Elektrothermografie</a></p>
      </div>
      <div class="fragen">
        {FRAGEN.map((q, i) => (
          <details open={i === 0}>
            <summary><h2 class="frage">{q.f}</h2></summary>
            <div><p>{q.a}</p></div>
          </details>
        ))}
      </div>
      <section class="begriffe" id="begriffe" aria-labelledby="begriffe-titel">
        <h2 id="begriffe-titel">Fachbegriffe kurz erklärt</h2>
        <dl>
          {BEGRIFFE.map(({ b, d }) => <div><dt>{b}</dt><dd>{d}</dd></div>)}
        </dl>
      </section>
      <p class="weiter">Weitere Fragen? <a href="/kontakt/">Schreiben Sie uns</a> – wir antworten gern.</p>
    </div>
  </section>
  <AnfrageBand />
</Basis>
<style>
  .kurz { max-width: var(--text-breite); padding: var(--s-5); border-left: 4px solid var(--glut); background: var(--grund); margin-bottom: var(--s-7); }
  .kurz h2 { font-size: 1.35rem; }
  .kurz p:last-child { margin: 0; }
  .frage { display: inline; font: inherit; color: inherit; margin: 0; }
  .begriffe { margin-top: var(--s-8); max-width: 52rem; }
  .begriffe dl { margin: 0; border-top: 2px solid var(--tinte); }
  .begriffe div { display: grid; gap: var(--s-1) var(--s-5); padding-block: var(--s-4); border-bottom: 1px solid var(--linie); }
  @media (min-width: 44rem) { .begriffe div { grid-template-columns: 15rem 1fr; } }
  .begriffe dt { font-weight: 600; color: var(--tinte); }
  .begriffe dd { margin: 0; color: var(--gedaempft); }
  .weiter { margin-top: var(--s-6); }
</style>
